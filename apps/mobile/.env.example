# apps/mobile/.env.example — copy to .env for local development.
# Expo automatically inlines any variable prefixed EXPO_PUBLIC_ into the JS
# bundle at build time, so only put PUBLIC, non-secret values here.

EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
# When testing on a physical device, use your machine's LAN IP instead of
# localhost, e.g. http://192.168.1.20:4000
EXPO_PUBLIC_API_URL=http://localhost:4000
