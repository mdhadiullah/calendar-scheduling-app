# apps/web/.env.example — copy to .env(.production) for each environment.
# Vite only exposes variables prefixed with VITE_ to client code, so only
# put PUBLIC, non-secret values here. Never put the Supabase service role
# key or SMTP/Telegram secrets in this file.

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-local-anon-key
VITE_API_URL=http://localhost:4000
