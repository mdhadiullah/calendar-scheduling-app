# ============================================================================
# apps/api/.env.example
# Copy to .env for local development. NEVER commit the real .env file.
# In production (Hostnin), set these as environment variables in the hosting
# control panel — do not upload a .env file to the server.
# ============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
# Hostnin assigns the port dynamically — always read process.env.PORT.
PORT=4000
APP_URL=http://localhost:5173
API_URL=http://localhost:4000

# --- Supabase ------------------------------------------------------------
# Local dev: values printed by `supabase start`.
# Production: Supabase Cloud project settings -> API.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-anon-key
# SERVICE ROLE KEY IS SECRET. Server-side only. Never send to any frontend.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# --- Email (SMTP) ----------------------------------------------------------
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=apikey-or-username
EMAIL_PASSWORD=replace-me
EMAIL_FROM="Calendar App <no-reply@yourdomain.com>"

# --- Telegram Bot ------------------------------------------------------------
TELEGRAM_BOT_TOKEN=replace-with-bot-token
TELEGRAM_BOT_USERNAME=YourCalendarAppBot

# --- Security ----------------------------------------------------------------
# Shared secret required in the `X-Cron-Secret` header for the scheduled job
# endpoints (/api/jobs/*). Generate with: openssl rand -hex 32
CRON_SECRET=replace-with-a-long-random-string
# Comma-separated list of allowed CORS origins (web + desktop + mobile dev).
CORS_ORIGINS=http://localhost:5173,http://localhost:1420,http://localhost:8081

# --- Rate limiting -------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# --- Optional: serve the built web app from this same process -----------
# Only needed if you deploy web+api as a single Hostnin Node.js Application
# (see docs/deployment.md). Leave unset to run the API as JSON-only and
# deploy apps/web separately.
# STATIC_WEB_DIR=../web/dist
